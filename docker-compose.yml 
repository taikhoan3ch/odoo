version: '3.1'

services:
  odoo:
    image: odoo:17  # hoặc phiên bản bạn muốn
    depends_on:
      - db
    ports:
      - "8069:8069"
    environment:
      - HOST=db
      - USER=postgres
      - PASSWORD=BrrBHzIGyoVBEFLbNTxfPFYhOTqLSmbH
      - DATABASE=railway
      - PGHOST=switchback.proxy.rlwy.net
      - PGPORT=36887
      - PGUSER=postgres
      - PGPASSWORD=BrrBHzIGyoVBEFLbNTxfPFYhOTqLSmbH
      - PGDATABASE=railway
    volumes:
      - odoo-data:/var/lib/odoo
      - ./addons:/mnt/extra-addons

  # Service "db" is optional here, since we're using Railway DB
  # Just define a placeholder to satisfy `depends_on`, but it's not used
  db:
    image: busybox
    entrypoint: /bin/sh
    command: -c "exit 0"

volumes:
  odoo-data:
